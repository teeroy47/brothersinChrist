// Brothers In Christ (BIC) - Prisma Schema
// PostgreSQL (Local / pgAdmin 4) & Supabase Compatible
//
// Member Journey mapped to schema:
//   10 Visitor              -> User row exists, journeyStageId = 10 (no Profile yet)
//   20 Create Profile       -> Profile created
//   30 Join BIC             -> User.joinedAt set (formal membership)
//   40 Assign Level         -> User.currentLevelId set
//   50 Assign Small Group   -> GroupMember created
//   60 Assign Accountability Partner -> AccountabilityPartner created
//   70 Daily Practices      -> DailyPractice rows logged
//   80 Weekly Check-In      -> CheckIn rows logged
//   90 Leader Review        -> LevelReview created
//  100 Growth Score         -> GrowthScore computed/updated
//
// Every stage transition is optionally logged to JourneyStageHistory so the
// funnel above can be reconstructed/reported on later.

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")   // pooled  (Supabase PgBouncer) — used by the app at runtime
  directUrl = env("DIRECT_URL")     // direct  (Supabase direct connection) — used by prisma migrate
}

generator client {
  provider = "prisma-client-js"
}

// -----------------------------------------------------------------------------
// 0. Configurable lookup tables (replace native Prisma enums)
//    Int codes are gap-spaced (10, 20, 30...) so new values can be inserted
//    later without renumbering, and are editable/admin-manageable as data
//    rather than requiring a migration.
// -----------------------------------------------------------------------------

model Role {
  id        Int     @id
  code      String  @unique
  label     String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  users User[]

  @@map("roles")
}
// seed: 10 MEMBER, 20 GROUP_LEADER, 30 LEVEL_LEADER, 40 ADMIN

model AttendanceStatus {
  id        Int     @id
  code      String  @unique
  label     String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  attendances Attendance[]

  @@map("attendance_statuses")
}
// seed: 10 PRESENT, 20 ABSENT, 30 EXCUSED, 40 LATE

model GroupRole {
  id        Int     @id
  code      String  @unique
  label     String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  members GroupMember[]

  @@map("group_roles")
}
// seed: 10 MEMBER, 20 CO_LEADER, 30 LEADER

model ReviewStatus {
  id        Int     @id
  code      String  @unique
  label     String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  reviews LevelReview[]

  @@map("review_statuses")
}
// seed: 10 PENDING, 20 NEEDS_FOLLOW_UP, 30 APPROVED

model JourneyStage {
  id        Int     @id
  code      String  @unique
  label     String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  users   User[]
  history JourneyStageHistory[]

  @@map("journey_stages")
}
// seed (mirrors the funnel diagram exactly):
// 10 VISITOR, 20 PROFILE_CREATED, 30 MEMBER, 40 LEVEL_ASSIGNED,
// 50 GROUP_ASSIGNED, 60 PARTNER_ASSIGNED, 70 DAILY_PRACTICE,
// 80 WEEKLY_CHECKIN, 90 LEADER_REVIEW, 100 GROWTH_SCORE

// -----------------------------------------------------------------------------
// 1. Identity Domain
// -----------------------------------------------------------------------------

model User {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String    @unique
  passwordHash    String?
  roleId          Int       @default(10)
  role            Role      @relation(fields: [roleId], references: [id])
  currentLevelId  String?   @db.Uuid
  currentLevel    Level?    @relation(fields: [currentLevelId], references: [id])

  // Journey tracking (stage 10 Visitor -> 100 Growth Score)
  journeyStageId  Int       @default(10)
  journeyStage    JourneyStage @relation(fields: [journeyStageId], references: [id])
  joinedAt        DateTime? // set when the user formally joins (stage 30)

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  profile               Profile?
  memberships           GroupMember[]
  ledGroups              Group[]                @relation("GroupLeader")
  checkIns               CheckIn[]
  dailyPractices          DailyPractice[]
  attendances            Attendance[]
  growthScore             GrowthScore?
  partnersAsUser1         AccountabilityPartner[] @relation("User1Partners")
  partnersAsUser2         AccountabilityPartner[] @relation("User2Partners")
  leaderReports            LeaderReport[]
  userLevelReviews         LevelReview[]          @relation("UserLevelReviews")
  reviewerLevelReviews     LevelReview[]          @relation("ReviewerLevelReviews")
  journeyStageHistory      JourneyStageHistory[]
  consents                 UserConsent[]
  reportsFiled             AbuseReport[]          @relation("ReporterAbuse")
  reportsAgainst           AbuseReport[]          @relation("ReportedAbuse")

  @@index([journeyStageId])
  @@map("users")
}

model Profile {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String    @unique @db.Uuid
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName        String
  firstName       String
  phone           String?
  city            String?
  ageRange        String?
  church          String?
  occupation      String?
  maritalStatus   String?
  testimony       String?   @db.Text
  spiritualGoals  String[]  @default([])
  fitnessGoals    String[]  @default([])
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@map("profiles")
}

// Logs each transition through the funnel shown in the member journey
// diagram, so the flow can be reconstructed/reported on per user.
model JourneyStageHistory {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String       @db.Uuid
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageId   Int
  stage     JourneyStage @relation(fields: [stageId], references: [id])
  enteredAt DateTime     @default(now())
  notes     String?      @db.Text

  @@index([userId])
  @@map("journey_stage_history")
}

// -----------------------------------------------------------------------------
// 2. Discipleship Domain
// -----------------------------------------------------------------------------

model Level {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  levelNumber   Int           @unique
  title         String
  description   String        @db.Text
  requirements  String[]      @default([])
  expectations  String[]      @default([])
  curriculum    String[]      @default([])
  growthMarkers String[]      @default([])
  meetings      String[]      @default([])
  users         User[]
  levelReviews  LevelReview[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@map("levels")
}

// Daily prayer / Bible practice log — distinct from the weekly CheckIn
// rollup. Corresponds to the "Daily Practices" stage in the journey.
model DailyPractice {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  practiceDate DateTime @db.Date
  prayed       Boolean  @default(false)
  readBible    Boolean  @default(false)
  notes        String?  @db.Text
  createdAt    DateTime @default(now())

  @@unique([userId, practiceDate])
  @@index([practiceDate])
  @@map("daily_practices")
}

enum VisibilityTier {
  PRIVATE              // Author only
  PARTNER_ONLY         // Author + designated AccountabilityPartner
  LEADER_DISCLOSED     // Author + Group Leader
  CIRCLE_SHARED        // Entire small group
}

model CheckIn {
  id                  String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String         @db.Uuid
  user                User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekLabel           String
  weekStartDate       DateTime       @db.Date
  prayerDays          Int            @default(0)
  bibleDays           Int            @default(0)
  attendedMeeting     Boolean        @default(false)
  metAccountability   Boolean        @default(false)
  servingContribution String?        @db.Text
  strugglesAndNeeds   String?        @db.Text
  strugglesVisibility VisibilityTier @default(PRIVATE)
  praiseReport        String?        @db.Text
  praiseVisibility    VisibilityTier @default(CIRCLE_SHARED)
  flags               String[]       @default([])
  flagsVisibility     VisibilityTier @default(PARTNER_ONLY)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@unique([userId, weekLabel])
  @@index([weekStartDate])
  @@map("check_ins")
}

model ReadingPlan {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  description String      @db.Text
  daysTotal   Int         @default(30)
  devotions   Devotion[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@map("reading_plans")
}

model Devotion {
  id                  String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId              String      @db.Uuid
  plan                ReadingPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  dayNumber           Int
  title               String
  scriptureReference  String
  passageText         String      @db.Text
  reflection          String      @db.Text
  prayerFocus         String      @db.Text
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  @@unique([planId, dayNumber])
  @@map("devotions")
}

// -----------------------------------------------------------------------------
// 3. Community Domain
// -----------------------------------------------------------------------------

model Group {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name            String
  summary         String        @db.Text
  leaderId        String        @db.Uuid
  leader          User          @relation("GroupLeader", fields: [leaderId], references: [id])
  nextMeeting     DateTime?
  prayerRequests  String[]      @default([])
  encouragements  String[]      @default([])
  members         GroupMember[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@map("groups")
}

model GroupMember {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId    String    @db.Uuid
  group      Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId     String    @db.Uuid
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupRoleId Int      @default(10)
  groupRole  GroupRole @relation(fields: [groupRoleId], references: [id])
  joinedAt   DateTime  @default(now())

  @@unique([groupId, userId])
  @@map("group_members")
}

model AccountabilityPartner {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user1Id       String    @db.Uuid
  user1         User      @relation("User1Partners", fields: [user1Id], references: [id], onDelete: Cascade)
  user2Id       String    @db.Uuid
  user2         User      @relation("User2Partners", fields: [user2Id], references: [id], onDelete: Cascade)
  status        String    @default("active")
  establishedAt DateTime  @default(now())

  @@unique([user1Id, user2Id])
  @@map("accountability_partners")
}

// -----------------------------------------------------------------------------
// 4. Engagement Domain
// -----------------------------------------------------------------------------

model Event {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title       String
  category    String
  audience    String        @default("all")
  location    String
  dateTime    DateTime
  attendances Attendance[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([dateTime])
  @@map("events")
}

model Attendance {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String           @db.Uuid
  user                User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  eventId             String           @db.Uuid
  event               Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attendanceStatusId  Int              @default(10)
  attendanceStatus    AttendanceStatus @relation(fields: [attendanceStatusId], references: [id])
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@unique([userId, eventId])
  @@index([eventId])
  @@map("attendance")
}

// -----------------------------------------------------------------------------
// 5. Growth Domain
// -----------------------------------------------------------------------------

model GrowthScore {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId              String    @unique @db.Uuid
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  overallConsistency  Int       @default(0)
  prayerScore         Int       @default(0)
  bibleScore          Int       @default(0)
  attendanceScore     Int       @default(0)
  servingScore        Int       @default(0)
  accountabilityScore Int       @default(0)
  recentActivity      String?
  updatedAt           DateTime  @updatedAt

  @@map("growth_scores")
}

// -----------------------------------------------------------------------------
// 6. Leadership Domain
// -----------------------------------------------------------------------------

model LeaderReport {
  id                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  leaderId                  String    @db.Uuid
  leader                    User      @relation(fields: [leaderId], references: [id])
  title                     String
  summary                   String    @db.Text
  prayerNeeds               String[]  @default([])
  memberIdsNeedingFollowUp  String[]  @default([])
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  @@index([leaderId])
  @@map("leader_reports")
}

model LevelReview {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId            String        @db.Uuid
  user              User          @relation("UserLevelReviews", fields: [userId], references: [id], onDelete: Cascade)
  reviewerId        String        @db.Uuid
  reviewer          User          @relation("ReviewerLevelReviews", fields: [reviewerId], references: [id])
  targetLevelId     String        @db.Uuid
  targetLevel       Level         @relation(fields: [targetLevelId], references: [id])
  reviewStatusId    Int           @default(10)
  reviewStatus      ReviewStatus  @relation(fields: [reviewStatusId], references: [id])
  feedback          String        @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([userId])
  @@map("level_reviews")
}

// -----------------------------------------------------------------------------
// 7. Schema Management
// -----------------------------------------------------------------------------

// Human-readable log of intentional schema changes.
// Prisma tracks migrations internally in _prisma_migrations; this table
// adds context (description, author) that is visible in the app and queryable.
model MigrationLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   @unique              // e.g. "add_journey_stage_history"
  version     String                        // semver or date tag, e.g. "2026-09-24"
  description String   @db.Text            // what changed and why
  appliedBy   String?                       // email / name of person who applied it
  appliedAt   DateTime @default(now())

  @@map("migration_logs")
}

// ============================================================================
// W3C PRIVACY & OWASP ASVS v5.0.0 SCHEMA ENHANCEMENTS
// ============================================================================

// User Consent Tracking Ledger (W3C §2.12.1, ASVS v5.0.0-14.1.3)
model UserConsent {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @db.Uuid
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  purposeCode      String    // "LEADER_OVERVIEW", "PARTNER_SHARING", "EMAIL_REMINDERS"
  granted          Boolean   @default(false)
  grantedAt        DateTime  @default(now())
  revokedAt        DateTime?
  ipAddress        String?
  userAgent        String?
  policyVersion    String    // "2026.1"

  @@index([userId, purposeCode])
  @@map("user_consents")
}

// Abuse & Safety Reporting (W3C §2.9.1, ASVS v5.0.0-2.1.1)
model AbuseReport {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  reporterId       String    @db.Uuid
  reporter         User      @relation("ReporterAbuse", fields: [reporterId], references: [id])
  reportedUserId   String?   @db.Uuid
  reportedUser     User?     @relation("ReportedAbuse", fields: [reportedUserId], references: [id])
  contextType      String    // "CIRCLE_MESSAGE", "PRAYER_REQUEST", "DIRECT_HARASSMENT"
  details          String    @db.Text
  status           String    @default("PENDING") // PENDING, UNDER_REVIEW, RESOLVED, DISMISSED
  resolutionNotes  String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([reporterId])
  @@map("abuse_reports")
}

// Data Access Audit Logging (W3C §2.8, ASVS v5.0.0-16.1.1)
model DataAccessAuditLog {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorId          String    @db.Uuid       // Leader or Admin who accessed the record
  targetUserId     String    @db.Uuid       // Member whose record was viewed
  recordType       String                   // "CHECK_IN", "PROFILE", "GROWTH_SCORE"
  recordId         String                   // Specific record UUID
  accessReason     String                   // Explicit justification
  accessedAt       DateTime  @default(now())

  @@index([targetUserId])
  @@map("data_access_audit_logs")
}

